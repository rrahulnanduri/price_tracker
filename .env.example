# Backend settings. Export these in your shell before starting uvicorn; all are optional.

# Price source: auto | google | serpapi | sites | demo
#   auto    = serpapi if SERPAPI_KEY is set, otherwise google
#   google  = scrape Google Shopping with Scrapling (free, fragile, rate-limited by Google)
#   serpapi = SerpApi's Google Shopping API (structured data, needs a key)
#   sites   = only the regional comparison sites (NL, BE, AU); nothing else needed
#   demo    = made-up prices for UI work and demos; labelled DEMO DATA in the app
PRICE_PROVIDER=auto
SERPAPI_KEY=
# With SerpApi: product pages opened per search for every seller of that item (1 credit each).
SERPAPI_SELLER_LOOKUPS=2
# Also query regional price-comparison sites (ignored in demo mode).
COMPARISON_SITES=true

# Browser for the Google scraper if its bundled one cannot start (locked-down machines).
# Empty = on Windows, fall back to Microsoft Edge automatically.
SCRAPER_BROWSER_PATH=

# Where price history and the watchlist are stored (SQLite file).
PRICE_DB=price_tracker.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Seconds a search result is reused before the source is asked again.
CACHE_TTL_SECONDS=900
# Live fetches allowed per client per minute (cache hits are free). 0 = unlimited.
RATE_LIMIT_PER_MINUTE=10
# Live fetches allowed to run at the same time.
MAX_CONCURRENT_FETCHES=2

# Hours between automatic re-checks of watchlist products. 0 = never.
REFRESH_HOURS=6
# POSTed a JSON body with a "text" field when a tracked price drops to its target
# (works as-is with Slack and Discord-compatible incoming webhooks).
ALERT_WEBHOOK_URL=

# Listings scoring below this (0..1) are treated as a different product. See evals/.
MIN_RELEVANCE=0.7
# Most stores returned per search (the UI shows 8, then "show all").
MAX_RESULTS=50

# Optional AI help through ScrapeGraphAI (pip install -r requirements-llm.txt).
# Off unless LLM_MODEL is set. Model is "provider/name", for example:
#   ollama/llama3.2            local, free; set LLM_BASE_URL=http://localhost:11434
#   openai/gpt-4o-mini         set LLM_API_KEY
#   anthropic/claude-haiku-5-5 set LLM_API_KEY; also pip install langchain-anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Context size; needed only for models ScrapeGraphAI does not already know.
LLM_MODEL_TOKENS=
# Read results pages with the LLM when the scraper's selectors find nothing.
LLM_FALLBACK=true
# Ask the LLM, once per search, whether borderline listings are the searched product.
LLM_JUDGE=true

# Frontend (put in .env.local): where the API lives.
# VITE_API_URL=http://localhost:8000
