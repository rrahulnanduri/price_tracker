# Backend settings. Export these in your shell before starting uvicorn; all are optional.

# Price source: auto | google | serpapi | demo
#   auto    = serpapi if SERPAPI_KEY is set, otherwise google
#   google  = scrape Google Shopping with Scrapling (free, fragile, rate-limited by Google)
#   serpapi = SerpApi's Google Shopping API (structured data, needs a key)
#   demo    = made-up offers for UI work and demos; labelled DEMO DATA in the app
PRICE_PROVIDER=auto
SERPAPI_KEY=

# Where price history and the watchlist are stored (SQLite file).
PRICE_DB=price_tracker.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Seconds a search result is reused before the source is asked again.
CACHE_TTL_SECONDS=900
# Live fetches allowed per client per minute (cache hits are free). 0 = unlimited.
RATE_LIMIT_PER_MINUTE=10
# Live fetches allowed to run at the same time.
MAX_CONCURRENT_FETCHES=2

# Hours between automatic re-checks of watchlist products. 0 = never.
REFRESH_HOURS=6
# POSTed a JSON body with a "text" field when a tracked price drops to its target
# (works as-is with Slack and Discord-compatible incoming webhooks).
ALERT_WEBHOOK_URL=

# Listings scoring below this (0..1) are treated as a different product. See evals/.
MIN_RELEVANCE=0.7
# Stores shown per search.
MAX_RESULTS=8

# Frontend (put in .env.local): where the API lives.
# VITE_API_URL=http://localhost:8000
